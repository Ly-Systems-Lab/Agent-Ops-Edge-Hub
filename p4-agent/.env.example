# Pi Hub · P4 Agent 适配器 环境变量样例
#
# 复制为 .env 后填入真实值。.env 不进 git（见仓库根 .gitignore）。
#   cp .env.example .env
#   chmod 600 .env
#
# systemd 单元通过 EnvironmentFile= 读取本文件。

# ---------- 设备与主题 ----------
# 设备 ID，决定主题前缀：hub/chat/<DEVICE_ID> 与 hub/device/<DEVICE_ID>/status
P4_DEVICE_ID=p4
# 主题前缀（一般不改）
P4_TOPIC_PREFIX=hub

# ---------- MQTT 连接 ----------
# agent 就装在 Pi 上，走回环即可；若 broker 在别的机器改成那台的地址
P4_MQTT_HOST=127.0.0.1
P4_MQTT_PORT=8883
# ACL 里的角色名，见 config/aclfile.example
P4_MQTT_USER=agent
# ★ 必填：用 mosquitto_passwd 给 agent 账号设的密码
P4_MQTT_PASS=

# ---------- TLS 证书 ----------
# 留空则默认取 <仓库>/p4-agent/certs/ 下的 ca.crt / agent.crt / agent.key
# P4_CA_FILE=
# P4_AGENT_CERT=
# P4_AGENT_KEY=

# ---------- OpenClaw Gateway ----------
P4_GATEWAY_URL=http://127.0.0.1:18789/v1/chat/completions
P4_GATEWAY_MODEL=openclaw/main
# ★ 必填：Gateway 的 bearer token
P4_GATEWAY_TOKEN=
