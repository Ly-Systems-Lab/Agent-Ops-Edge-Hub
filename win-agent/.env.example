# winagent 凭据样例 —— 复制为 .env 并填入真实值（.env / *.key / *.crt 都不进 git）
#
# ⚠️ 这里的值全是占位符。**真实 IP、真实密码、真实证书一律不要放进本仓。**
# 凭据文件建议放在仓库之外（例如工位机上单独一个目录），给它 600 权限。
#
# 查找顺序：--env PATH  >  环境变量 WINAGENT_ENV  >  当前目录下的 .env
# 证书类相对路径**相对于本文件所在目录**解析 —— 整套凭据可以整体搬走。

WIN_MQTT_HOST=192.168.1.100
WIN_MQTT_PORT=8883
WIN_MQTT_USER=win
WIN_MQTT_PASSWORD=

# 证书 / 私钥默认按账号名推导：<user>.crt 与 <user>.key（Pi 侧签发时就是这个名字）。
# 文件名不一致时再取消下面两行的注释显式指定。
#WIN_MQTT_CA=ca.crt
#WIN_MQTT_CERT=win.crt
#WIN_MQTT_KEY=win.key