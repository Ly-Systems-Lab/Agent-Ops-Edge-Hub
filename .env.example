# Pi Hub 环境变量样例 —— 复制为 .env 并填入真实值（.env 不进 git）
#
# 凭证类（企微智能机器人 · 长连接 API 模式）
# ⚠ 三对凭证互相独立，各建一个机器人，不要复用：
WECOM_CORP_ID=
# ① 小电视（ESP32 C3）机器人
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# ② P4 面板机器人
#P4_WECOM_BOT_ID=
#P4_WECOM_BOT_SECRET=
# ③ 曼波小车机器人（2026-10-30 接入）
#CAR_WECOM_BOT_ID=
#CAR_WECOM_BOT_SECRET=
#
# ── ★ 必填：小电视（ESP32）的局域网 IP ──
# 企微控制/指令靠它找到设备。不填 ⇒ 屏幕能显示数据，但"发指令"必然失败
# （表现：企微回 "执行失败（ESP32 返回 502）"）。
# ⚠️ 当前固件【没有】主动上报 IP 的实现（全文只有 GET /api/esp32_ip）。
#    2026-10-30 起 Pi 侧改成**被动学习**：C3 只要来取数（GET / stock·kline·weather），
#    api.py 就把它的真实源 IP 记下来（30 s 节流；只认 5000 端口；只从 http_allow 白名单内学）。
#    ⇒ 手工填一次仍是**推荐**做法（省掉"等它先来取数"这一段），但已不是唯一途径。
#    注意：被动学习要求 C3 的 IP 已在 http_allow 里，否则它连请求都进不来（403）。
smalltv_ip=
#
# ── ★ HTTP 访问白名单（2026-10-30 新增）──
# 默认只放行回环 127.0.0.1。要让 ESP32 能访问 Flask，必须把它的 IP 加进来。
# ⚠️ 强烈建议写【设备固定 IP】而非整网段 —— 网段放通等于同网段所有设备
#    都能读行情、控设备。HTTP 层除了 IP 白名单没有第二道门。
# 支持 CIDR（如 192.168.1.0/24），但端口 5000 不要暴露到公网。
# 含 0.0.0.0/0 会直接拒绝启动。
http_allow=127.0.0.1
#
# 可选覆盖项（一般无需设置，默认值已够用）
# 数据库路径（默认 <project>/data/pihub.db）
#PIHUB_DB=/home/pi/cooperate/pihub/data/pihub.db
# devctl 访问 Flask 的地址（默认优先 127.0.0.1 回环，换 IP/换段免疫）
#PIHUB_API_HOST=127.0.0.1
# 注：具体应配置到服务环境中即可
#
# 说明：mqtt_host / mqtt_port / pihub_port / smalltv_ip / pihub_host_remote /
# wecom_chat_id / wecom_chat_type 等运行期配置存在 SQLite config 表
# （优先级：环境变量 > .env > SQLite config 表 > 代码默认值）。
# 可在服务运行后用 `python3 app/config.py` 查看当前生效值。
